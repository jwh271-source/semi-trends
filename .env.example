# 공공데이터포털 API 인증키 (법령 추적용)
# 발급: https://www.data.go.kr → "법령공포정보서비스" 또는 "국가법령정보센터 법령정보조회서비스" Open API 활용신청
# 발급받은 인증키(Decoding Key)를 아래에 붙여넣으세요.
# (실제 키는 GitHub Secret 의 DATA_API_KEY 로 등록 — 이 파일엔 값 없이 둠)
DATA_API_KEY=

# 사내 LLM (로컬에서만 사용. GitHub Actions에는 설정 안 함 → 키워드 방식 사용)
# LLM_ENABLED=1이면 LLM으로 기사 분류+요약+키워드 추천. 0이면 키워드 방식(발췌 요약).
LLM_ENABLED=0
LLM_BASE_URL=http://common.llm.skhynix.com
LLM_TOKEN=
LLM_MODEL=GLM-5.2
